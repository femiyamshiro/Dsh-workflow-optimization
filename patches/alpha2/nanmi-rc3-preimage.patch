+/** Install into exactly one child scope before its first model request. */
+export function installMemberSetup(ctx, snapshot) {
+    const disposers = [];
+    let disposed = false;
+    const dispose = () => {
+        if (disposed)
+            return;
+        disposed = true;
+        for (const undo of disposers.reverse())
+            undo();
+    };
+    try {
+        disposers.push(ctx.systemPrompt.section({
+            name: 'deployment:persona-prefix',
+            order: ctx.systemPrompt.getSectionOrder('DEPLOYMENT_PERSONA_PREFIX'),
+            text: snapshot.persona,
+        }));
+        disposers.push(ctx.tools.restrict(snapshot.filter));
+        ctx.effect(() => dispose, 'agent-teams: alpha4 member composition');
+        return dispose;
+    }
+    catch (error) {
+        dispose();
+        throw error;
+    }
+}
