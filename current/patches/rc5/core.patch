+
+/** Wait for direct settlement, retaining observation errors and allowing cancellation. */
+async function settledBeforeAbort(done: Promise<void>, signal: AbortSignal): Promise<boolean> {
+  if (signal.aborted) return false
+  let abort!: () => void
+  const cancelled = new Promise<false>((resolve) => { abort = () => { resolve(false) } })
+  signal.addEventListener('abort', abort, { once: true })
+  try {
+    return await Promise.race([done.then(() => true), cancelled])
+  } finally {
+    signal.removeEventListener('abort', abort)
+  }
+}
+
+/**
+ * Strong job producer: completed/killed certifies the provider range is empty.
+ * A failed producer never certifies drainage. Cancellation bounds cleanup but
+ * cannot turn an unknown range into a successful terminal outcome.
+ * @param start Starts the process with the job cancellation signal.
+ * @param outcome Computes the direct-command outcome after the range drains.
+ * @param cleanupTimeoutMs Maximum time to confirm range drainage after cancellation.
+ * @returns Job hooks whose terminal success requires a confirmed empty range.
+ */
+export function managedProcessJob(
+  start: (signal: AbortSignal) => Promise<ShellProcess>,
+  outcome: (process: ShellProcess) => JobOutcome,
+  cleanupTimeoutMs: number,
+): JobHooks {
+  const controller = new AbortController()
+  const cleanup = new AbortController()
+  let process: ShellProcess | undefined
+  let timer: ReturnType<typeof setTimeout> | undefined
+  let finished = false
+  const terminate = () => {
+    timer ??= setTimeout(() => { cleanup.abort() }, cleanupTimeoutMs)
+    if (process?.managedRange) process.managedRange.terminate()
+    else process?.kill()
+  }
+  const done: Promise<JobOutcome> = (async () => {
+    try {
+      process = await start(controller.signal)
+      const range = process.managedRange
+      if (range === undefined) throw new Error('managed range unavailable for this execution')
+      if (controller.signal.aborted) terminate()
+      let drained = await range.waitForExit(controller.signal)
+      if (!drained && controller.signal.aborted) {
+        terminate()
+        drained = await range.waitForExit(cleanup.signal)
+      }
+      if (!drained) throw new Error('managed range drain not confirmed within cleanup budget')
+      let directSettled = await settledBeforeAbort(process.done, controller.signal)
+      if (!directSettled && controller.signal.aborted) {
+        terminate()
+        directSettled = await settledBeforeAbort(process.done, cleanup.signal)
+      }
+      if (!directSettled) throw new Error('direct command settlement not confirmed within cleanup budget')
+      return controller.signal.aborted ? { status: 'killed', detail: 'managed range drained after cancellation' } : outcome(process)
+    } catch (error: unknown) {
+      // Best effort cleanup does not erase the original observation failure.
+      try {
+        terminate()
+        await process?.managedRange?.waitForExit(cleanup.signal)
+      } catch (_cleanupError: unknown) { /* original failure remains authoritative */ }
+      return { status: 'failed', detail: error instanceof Error ? error.message : String(error) }
+    } finally {
+      finished = true
+      if (timer !== undefined) clearTimeout(timer)
+    }
+  })()
+  return {
+    cancel: (reason) => {
+      if (finished || controller.signal.aborted) return
+      controller.abort(reason)
+      terminate()
+    },
+    done,
+  }
+}
