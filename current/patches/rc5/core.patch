+import { expect, it, vi } from 'vitest'
+import type { ShellProcess, ShellManagedRange } from '@deepseek-ai/dsh-shell'
+import { managedProcessJob, processOutcome } from '../src/background.ts'
+function handle(range?: ShellManagedRange) {
+  return { status:'completed',exitCode:0,signal:null,done:Promise.resolve(),...range === undefined ? {} : { managedRange: range },
+    readOutput:()=>({ delta:'',lossy:false }),kill:vi.fn(()=>false),
+    observed:{ stdout:{ readFrom:()=>({ text:'',nextOffset:0,lossy:false }) },stderr:{ readFrom:()=>({ text:'',nextOffset:0,lossy:false }) } } } satisfies ShellProcess
+}
+function deferredRange(){
+  const empty=Promise.withResolvers<boolean>()
+  const terminate=vi.fn()
+  const range:ShellManagedRange={ terminate,waitForExit:signal=>new Promise((resolve,reject)=>{
+    if(signal?.aborted){resolve(false);return}
+    const abort=()=>{ resolve(false) }
+    signal?.addEventListener('abort',abort,{ once:true })
+    void empty.promise.then(resolve,reject).finally(()=>signal?.removeEventListener('abort',abort))
+  }) }
+  return{ range,empty,terminate }
+}
+it('range job stays live after direct exit and preserves nonzero exit after drain',async()=>{
+  const d=deferredRange(),p=handle(d.range);p.exitCode=7
+  const hooks=managedProcessJob(async()=>p,processOutcome,200)
+  let finished=false;void hooks.done.then(()=>{finished=true});await Promise.resolve();await Promise.resolve()
+  expect(finished).toBe(false);d.empty.resolve(true)
+  expect(await hooks.done).toEqual({ status:'completed',detail:'exit code: 7' })
+  hooks.cancel('too late');expect(d.terminate).not.toHaveBeenCalled()
+})
+it.each(['published','preparation'] as const)('cancellation during %s terminates descendants even after leader exit',async (timing)=>{
+  const d=deferredRange(),p=handle(d.range),prepared=Promise.withResolvers<ShellProcess>()
+  const hooks=managedProcessJob(()=>prepared.promise,processOutcome,200)
+  if(timing==='published'){prepared.resolve(p);await Promise.resolve()}
+  hooks.cancel('stop');prepared.resolve(p);await Promise.resolve();await Promise.resolve()
+  expect(d.terminate).toHaveBeenCalled();expect(p.kill).not.toHaveBeenCalled()
+  d.empty.resolve(true);expect((await hooks.done).status).toBe('killed');expect(p.exitCode).toBe(0)
+})
+it('cleanup budget expires as failed without waiting indefinitely for direct command',async()=>{
+  const d=deferredRange(),p={ ...handle(d.range),done:new Promise<void>(()=>{}) }
+  const hooks=managedProcessJob(async()=>p,processOutcome,20)
+  await Promise.resolve();hooks.cancel('stop')
+  expect(await hooks.done).toMatchObject({ status:'failed',detail:'managed range drain not confirmed within cleanup budget' })
+  d.empty.resolve(true)
+})
+it('observation rejection cannot become success even if cleanup later succeeds',async()=>{
+  const terminate=vi.fn(),wait=vi.fn().mockRejectedValueOnce(Error('observation unavailable')).mockResolvedValue(true)
+  const hooks=managedProcessJob(async()=>handle({ terminate,waitForExit:wait }),processOutcome,200)
+  expect(await hooks.done).toEqual({ status:'failed',detail:'observation unavailable' });expect(terminate).toHaveBeenCalledOnce()
+})
+it('missing handle fails and requests available direct cleanup',async()=>{
+  const p=handle();const hooks=managedProcessJob(async()=>p,processOutcome,200)
+  expect((await hooks.done).status).toBe('failed');expect(p.kill).toHaveBeenCalledOnce()
+})
+it('unexpected false observation remains failed',async()=>{
+  const terminate=vi.fn();const hooks=managedProcessJob(async()=>handle({ terminate,waitForExit:async()=>false }),processOutcome,200)
