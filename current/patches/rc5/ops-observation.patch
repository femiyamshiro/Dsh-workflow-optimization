+ ['normal publication',file=>publish(file,'delta')],
+ ['same-size concurrent writer',file=>{publish(file,'delta');publish(file,'OTHER')}],
+ ['different-size concurrent writer',file=>{publish(file,'delta');publish(file,'OTHER-LONG')}],
+ ['delete and recreate',file=>{publish(file,'delta');fs.unlinkSync(file);publish(file,'OTHER')}],
+ ['delete after publication',file=>{publish(file,'delta');fs.unlinkSync(file)}],
