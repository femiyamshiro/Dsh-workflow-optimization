+ f.set({action:()=>publish(f.file,'delta'),response:{status:'completed',changed:1,items:[{path:f.file,bytesAfter:5}]}});
+ await f.call();assert.deepEqual(await f.intent(),before);await assert.rejects(f.edit(),{code:'FS_STALE_VERSION'});
+ await f.read();await f.edit();assert.equal(fs.readFileSync(f.file,'utf8'),'final');
+}));
