+import {WORKER,requireWorker} from './lib/boundary.mjs';
+const {invoke}=await import(process.env.OPS_WORKER_ENTRY ? pathToFileURL(process.env.OPS_WORKER_ENTRY).href : '../lib/file/worker.js');
+requireWorker('local-observation');
+const publish=(file,text)=>{const tmp=file+'.next';fs.writeFileSync(tmp,text);fs.renameSync(tmp,file)};
+async function fixture(body,{real=false}={}) {
+ await withTempDir('observation',async root=>{
+  const file=path.join(root,'a.txt');fs.writeFileSync(file,'alpha');
+  const {ctx}=await bootHost();const exec={agent:{session:{id:'local-observation',header:{cwd:root}}},signal:new AbortController().signal};
+  let response={status:'completed',changed:1,items:[{path:file,bytesAfter:5}]},action=()=>publish(file,'delta'),exitCode=0,interrupted=false;
+  const events=[];
+  try {
+   await ctx.plugin(FileSystem,{});await ctx.plugin(ObservationPolicy);
+   await ctx.plugin(inner=>inner.provide('sandboxPolicy',{resolve:()=>({mode:'danger-full-access',workspaceRoot:root})}));
+   if(real)await ctx.plugin(Subprocess);else await ctx.plugin(inner=>inner.provide('subprocess',{spawn:()=>{
+    action();return {done:Promise.resolve({exitCode,...(interrupted?{signal:'SIGTERM'}:{})}),collected:{stdout:{readFrom:()=>({text:JSON.stringify(response),lossy:false})},stderr:{readFrom:()=>({text:'',lossy:false})}}};
+   }}));
+   ctx.on('fs/observed',(target,observation)=>events.push({target,observation}));
+   const host=ctx.get('fs'); const target=await host.resolve(file,{cwd:root});
+   const intent=()=>ctx.waterfall('fs/edit-intent',target,exec,()=>undefined);
+   const call=(tool='replace',args={path:file,pattern:'alpha',replacement:'delta'})=>invoke(ctx,WORKER,tool,args,exec,exec.signal);
+   const read=()=>{response={status:'completed',items:[{status:'completed',items:[{text:fs.readFileSync(file,'utf8')}]}]};action=()=>{};return call('read_files',{files:[{path:file}]})};
+   const edit=async(oldString='delta')=>host.editText(target,{oldString,newString:'final'},await intent());
+   await body({file,host,target,events,intent,call,read,edit,set(v){if(v.response)response=v.response;if(v.action)action=v.action;if(v.exitCode!==undefined)exitCode=v.exitCode;if(v.interrupted!==undefined)interrupted=v.interrupted}});
+  }finally{await shutdown(ctx)}
+ });
+}
