+ f.set({action:()=>publish(f.file,'OTHER'),response:{status:'completed',items:[{status:'completed'}]}});
+ await f.call('read_files',{files:[{path:f.file}]});assert.equal(f.events.length,1);await assert.rejects(f.edit('OTHER'),{code:'FS_STALE_VERSION'});
