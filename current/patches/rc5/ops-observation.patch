+ assert.equal(f.events.length,0);await assert.rejects(f.intent(),{code:'FS_NOT_OBSERVED'});
+}));
+for(const status of ['partial','error'])await test(`${status} mutation never observes`,()=>fixture(async f=>{
+ f.set({response:{status,changed:1,items:[{path:f.file,bytesAfter:5}]}});await f.call();assert.equal(f.events.length,0);await assert.rejects(f.intent(),{code:'FS_NOT_OBSERVED'});
+}));
+await test('dry run never observes',()=>fixture(async f=>{
+ f.set({action:()=>{},response:{status:'completed',dryRun:true,changed:1,items:[{path:f.file,bytesAfter:5}]}});await f.call();assert.equal(f.events.length,0);
+}));
+for(const failure of ['nonzero','interrupted'])await test(`${failure} never observes`,()=>fixture(async f=>{
+ f.set(failure==='nonzero'?{exitCode:1}:{interrupted:true});assert.equal((await f.call()).status,'error');assert.equal(f.events.length,0);
+}));
